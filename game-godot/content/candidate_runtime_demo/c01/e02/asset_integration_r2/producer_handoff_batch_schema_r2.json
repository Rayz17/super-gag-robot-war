{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chao-gag:c01cdv1:m2.2:r2:producer-handoff-batch:v1",
  "title": "C01E02 M2.2 Producer Exact Handoff Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "schema_version",
    "runtime_lane",
    "authorization_scope",
    "lifecycle_status",
    "synthetic_fixture",
    "contract_binding",
    "profile_binding",
    "handoffs"
  ],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "runtime_lane": {"const": "candidate_runtime_demo"},
    "authorization_scope": {"const": "C01E02_M2_2_EXACT_SLOT_HANDOFF"},
    "lifecycle_status": {"const": "active"},
    "synthetic_fixture": {"type": "boolean"},
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_revision", "build_id", "save_schema", "content_fingerprint"],
      "properties": {
        "contract_revision": {"const": 2},
        "build_id": {"const": "C01CDV1-M2-R2"},
        "save_schema": {"const": 2},
        "content_fingerprint": {"const": "00f20b087b384f40f2a3602c25d41220dbda7504562533e811b6986522963fd4"}
      }
    },
    "profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "topology_sha256"],
      "properties": {
        "profile_id": {"const": "c01cdv1_e02_scroll_m2_r2"},
        "topology_sha256": {"const": "baefc17f22f1a7d8956133e73be3a4d0e1a62a369441d782701975fa6230f8d8"}
      }
    },
    "handoffs": {
      "type": "array",
      "items": {"$ref": "asset_slot_schema_r2.json#/$defs/handoff"},
      "uniqueItems": true
    }
  }
}
