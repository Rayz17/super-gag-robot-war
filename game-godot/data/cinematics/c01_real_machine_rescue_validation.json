  "dialogue_beats": [
    {
      "beat_id": "entry",
      "lines": [
        {"speaker": "闭馆广播", "profile": "scene_caption", "text": "现实机器区将在十分钟后断开观众电源。仍在自检的设备会留在原位，不会被赶着表演一次成功。"},
        {"speaker": "唐胶", "profile": "scene_caption", "text": "总算说了句像人话的广播。是谁改的？"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "旧守护者。它最近把投诉信当语言教材。"},
        {"speaker": "兜灯", "profile": "scene_caption", "text": "闲话等断电后。你要留馆守 Z 接应，就先把谁能停它说清楚。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "走近兜灯与唐胶，确认停机权、拆解权与最终责任。"}
      ]
    },
    {
      "beat_id": "authority_doudeng",
      "lines": [
        {"speaker": "纪存", "profile": "scene_caption", "text": "停机权还在你手里吗？"},
        {"speaker": "兜灯", "profile": "scene_caption", "text": "在。我刚按过测试停机，继电器会断。"},
        {"speaker": "纪存", "profile": "halfbody_focus", "side": "left", "role_line": "纪存 / 几何半身占位", "text": "写在我名字前面。真出事，先让你的按钮有效，再来找我算总账。"},
        {"speaker": "兜灯", "profile": "scene_caption", "text": "行。你要是把‘救人’当过热理由，我照样切。"}
      ]
    },
    {
      "beat_id": "authority_tangjiao",
      "lines": [
        {"speaker": "唐胶", "profile": "scene_caption", "text": "拆解权给我可以。先说明白：整块罩拆下来，边缘一定留钻痕。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "需要拆的时候，你决定怎么拆。要不要拆，我担。"},
        {"speaker": "唐胶", "profile": "scene_caption", "text": "这句我存一下。省得明天有人拿着完好率问我，为什么救人不无痕。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "交权完成。闭馆巡检开放：四项条件必须在房间里实际确认。"}
      ]
    },
    {
      "beat_id": "inspect_diedie",
      "lines": [
        {"speaker": "纪存", "profile": "scene_caption", "text": "今天最后一次。你愿意走到充电线外吗？"},
        {"speaker": "跌跌", "profile": "scene_caption", "text": "站立测试：第九次。目标不是不摔，是摔了还能回到充电位。"},
        {"speaker": "成年观众", "profile": "scene_caption", "text": "不着急。我那条腿也不喜欢别人倒数。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "已读：失败记录、窄缝通行、任务后回充终点。"}
      ]
    },
    {
      "beat_id": "inspect_machine_dog",
      "lines": [
        {"speaker": "机器犬", "profile": "scene_caption", "text": "门内指令：留置。门外指令：撤离。等待人类确认对象。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "你负责开门和出力。让谁走哪条线，不用你替我们背。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "已读：手动牵引线、双指令冲突、旧门开门能力。"}
      ]
    },
    {
      "beat_id": "inspect_old_door",
      "lines": [
        {"speaker": "唐胶", "profile": "scene_caption", "text": "这道宽门没接新分类器。丑是丑，至少不会看见轮椅就问是不是资产。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "手动锁能开。代价是把旧搬运路由公开到事故日志。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "已读：旧服务宽门与公开责任。"}
      ]
    },
    {
      "beat_id": "inspect_visitor",
      "lines": [
        {"speaker": "纪存", "profile": "scene_caption", "text": "从这里到门口，哪一段最难走？"},
        {"speaker": "成年观众", "profile": "scene_caption", "text": "不是坡。那块地砖反光，我落杖时看不清边。灯再暗一点，我宁可自己慢慢来。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "机器犬只给拉力。跨哪一步，你说了算。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "已读：成人自主跨步、无台阶路线、低照度风险。"}
      ]
    },
    {
      "beat_id": "inspect_low_heat",
      "lines": [
        {"speaker": "兜灯", "profile": "scene_caption", "text": "南侧母线刚隔离。这里不会被自动照明加热。"},
        {"speaker": "唐胶", "profile": "scene_caption", "text": "如果非得借胸灯，只能把光折进这一块。输出不许加。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "已读：低热扇区、可改光路、主动力锁死。"}
      ]
    },
    {
      "beat_id": "white_frame_reject",
      "lines": [
        {"speaker": "系统", "profile": "scene_caption", "text": "人类紧急出口可用。辅助资产将留置。"},
        {"speaker": "成年观众", "profile": "scene_caption", "text": "辅助资产是说我的支具，还是说我？"},
        {"speaker": "纪存", "profile": "halfbody_focus", "side": "left", "role_line": "纪存 / 承担旧路由公开责任", "text": "关掉这条。人和机器走同一条线。旧搬运路由由我公开，迟报也记在我名下。"},
        {"speaker": "兜灯", "profile": "scene_caption", "text": "早三分钟听我的，现在不用走旧路。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "对。先救人，账别替我藏。"},
        {"speaker": "系统", "profile": "scene_caption", "text": "三步战术开始。R1：按训练执行标准救援。"}
      ]
    },
    {
      "beat_id": "r1_failure",
      "lines": [
        {"speaker": "系统", "profile": "scene_caption", "text": "复位、牵引均完成。成功样机规则已预测标准动作。路径框重新封闭。"},
        {"speaker": "机器犬", "profile": "scene_caption", "text": "门已开。路线对象未确认。停止牵引。"},
        {"speaker": "兜灯", "profile": "scene_caption", "text": "不是力量不够。它在等我们做正确动作，然后提前把正确答案封掉。"},
        {"speaker": "纪存", "profile": "scene_caption", "text": "那就别再给它一份成功示范。调跌跌的失败记录。"}
      ]
    },
    {
      "beat_id": "r2_wrong",
