      "actor": "narrator",
      "line": "“万机馆”的报名被退了回来。接待屏上亮出临时保全人的权限。"
    },
    {
      "actor": "jiaojia",
      "line": "能停泊、保命、维修，也能接收救命的替换件。"
    },
    {
      "actor": "jiaojia",
      "line": "拿一船待移交资产去参加商业赛事，不行。"
    },
    {
      "actor": "tangjiao",
      "line": "走吧。"
    },
    {
      "actor": "jicun",
      "line": "去哪儿？"
    },
    {
      "actor": "tangjiao",
      "line": "找一个有资格上场、又肯把奖品借给你的人。"
    },
    {
      "actor": "tangjiao",
      "line": "最好还打得过那台。"
    }
