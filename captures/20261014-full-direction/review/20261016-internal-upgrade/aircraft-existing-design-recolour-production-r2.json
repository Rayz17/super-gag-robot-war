    "observations": {
      "M08": [
        "保留窄长头盔、红中脊与双尖、叶形黄胸核、放射刃翼、宽胫尖足和原下垂短枪。",
        "主块从旧紫灰蓝整理为更清楚的钴蓝/墨蓝，朱红和象牙仍沿原部件分布；手和枪改深石墨。",
        "首轮肩臂残留旧贴图裂纹样亮线；R2b已局部清理，肩/胫以完整蓝面和少量硬阴影为主。"
      ],
      "M14": [
        "保留长双红角、尖收头脸、黄胸核、横肩翼、垂翼臂甲和修长腿足。",
        "沿现用红白涂装改为暖象牙与朱红大面，关节/手/足收为石墨，座舱和少量功能边保留暖黄。",
        "首轮红色臂翼和腿甲残留碎亮线；R2b已局部清理，红色长面与象牙甲片的分区更完整。"
      ]
    },
    "final_surface_observation": {
      "M08": "已实看R2b：肩甲的淡蓝裂纹样亮线大部分去除，肩/胫的大蓝面更完整；原红中脊、放射刃翼、黄胸核、下垂短枪与航空发动机群仍可追认。",
      "M14": "已实看R2b：红色臂翼和胫甲的碎亮线明显减少，暖象牙/朱红/石墨大块关系清楚；长双红角、肩翼、垂翼甲和修长身形仍可追认。"
    },
    "invariant_limits": "主要外轮廓、头胸和翼形经作者实看保留；生成线稿不等于逐顶点或逐面精确保持原模型，隐面与发动机内部未验证。"
  },
  "limitations": [
    "二维重绘保留主要识别点，不等于原模型逐面换色；白底编排与原诊断图不是同像素相机对照。",
    "两形态的轮廓和涂装关系供设计审阅，未验证完整折变、三视几何或连续动作。",
    "未改原模型/贴图/骨架/动作或运行入口；新色样未获用户采用。"
  ],
