  "current_revision_issues": [
    "BR11-01: 面罩终态与加载前的原头统一",
    "BR11-02: 背面发动机尾端改为排气口",
    "BR11-03: 胸部机鼻统一短钝端面",
    "BR11-04: 单体机身与双格栅背包需要对应",
    "BR11-05: 列车臂壳明确收拢与展开两个状态",
    "BR11-06: 钻机履带、座舱与腿足的去向补齐",
    "BR11-07: 勇拳胸口标识统一",
