    "findings": [
      {
        "id": "BR11-01",
        "kind": "visible_difference",
        "group": "局部修图",
        "title": "面罩终态与加载前的原头统一",
        "images": [
          6,
          8,
          9,
          10,
          11
        ],
        "observation": "图9装好后额前出现青色宝石；图10整机额部是橙色竖片/石墨底。图8左上灰色核心又已戴合体头冠，与图9后加载的过程冲突。",
        "correction": "以图10作为合体头终态，图6/11作为原头；图9只校正外面罩额部，图8灰色核心恢复原头。保留长发和原头本体，不改成换整颗头，也不解释为核心自己长出新冠。",
        "preserve": "保留图9的机身内收纳→加载→装好机制与图8翼架让位。",
        "status": "identified_not_redrawn"
      },
      {
        "id": "BR11-02",
        "kind": "visible_difference",
        "group": "局部修图",
        "title": "背面发动机尾端改为排气口",
        "images": [
          1,
          2,
          3,
          10
        ],
        "observation": "图2背向的翼下两台发动机仍能读到进气风扇/轮毂；图1、3、10已经规定进气端朝前。",
        "correction": "仅修改图2翼下两处后端开口：无进气风扇，改为凹入深色排气喷口/分瓣尾圈。保持发动机筒长、肩甲斜三角体积、翼根与背包位置。",
        "preserve": "不重新解释图1肩甲，不把选定侧肩压成薄平翼条。",
        "status": "identified_not_redrawn"
      },
      {
        "id": "BR11-03",
        "kind": "visible_shape_difference",
        "group": "局部修图",
        "title": "胸部机鼻统一短钝端面",
        "images": [
          1,
          3,
          8,
          10
        ],
        "observation": "图1侧胸机鼻仍读成偏尖长的下探前端；图3、10是更饱满的短钝机鼻。图8细部也需随主稿核对。",
        "correction": "以图3机鼻立体形与图10胸部安装外观为准，侧面收尖、收短，保留橙色端面/象牙白颊框与蓝黑舱窗。只改鼻端，不重造肩胸框架。",
        "preserve": "侧向纵深可以比正面显著；不因正常透视差异横向挤压整张图。",
        "status": "identified_not_redrawn"
      },
      {
        "id": "BR11-04",
        "kind": "missing_correspondence_not_proven_geometry_error",
        "group": "补清部件对应",
        "title": "单体机身与双格栅背包需要对应",
        "images": [
          2,
          3,
          8
        ],
        "observation": "图2明确上下两处矩形格栅；图3和图8独立背包部件只清楚交代一处。由现有角度不能断言另一口不存在，但来源尚未说明。",
        "correction": "背包终态沿图2。补一张后下侧小示意，说明第二格栅随哪片机身翻到背部；图8分件补齐双口和同一壳体边界。无需为此改整架飞机轮廓。",
        "preserve": "双竖翼和中置背包的总体位置不改；无需工程级精密变形。",
        "status": "mapping_to_be_drawn"
      },
      {
        "id": "BR11-05",
        "kind": "state_definition_gap",
        "group": "补清部件对应",
        "title": "列车臂壳明确收拢与展开两个状态",
        "images": [
          1,
          2,
          4,
          7,
          10
        ],
        "observation": "图7是大幅开壳的安装/炮击状态；图1、2、10主要看到收拢的列车外侧壳。它们可解释成同一结构的两个状态，不能只凭外观差异判成不同车型。短翼和底盘件在展开态的去向未交代。",
        "correction": "固定待机收拢/炮击展开两态：一节对应一臂，两半壳左右打开，车头永远退向肘后，中间连接端朝拳前；短翼贴壳折收。用一次侧向开合说明炮口和核心前臂的位置，不缩小或遮掉巨拳。",
        "preserve": "保留图4车型、图7开壳方向与图10整机待机轮廓。",
        "status": "two_state_mapping_to_be_drawn"
      },
      {
        "id": "BR11-06",
        "kind": "missing_correspondence",
        "group": "补清部件对应",
        "title": "钻机履带、座舱与腿足的去向补齐",
        "images": [
          1,
          2,
          5,
          10
        ],
        "observation": "图5每个半车体有分组履带、座舱窗面和分段白壳；图1/2/10规定了膝钻、胫甲、踝及脚掌，但原有图未清楚交代这些载具部件分别归到哪里。不能因画法相似就宣布变形闭合。",
        "correction": "安装后形态以图10为首要比例依据、图1/2补侧后。只补同色编号分件示意：左右半车各进一腿，膝钻、胫前白甲、前后带面、踝足/后跟分别标清；座舱窗面折入内后侧。履带分组的具体分配在这张示意中核对，不另生一副长腿。",
        "preserve": "不采用R9长小腿。R10细图未包含在本次11张选择中，保留作补充候选，不自行替换图10。无需连续真实机械折变模拟。",
        "status": "mapping_to_be_drawn"
      },
      {
        "id": "BR11-07",
        "kind": "visible_decal_difference",
        "group": "制作时归一",
        "title": "勇拳胸口标识统一",
        "images": [
          6,
          11
        ],
        "observation": "图11有橙色胸标，图6三视留白。主体结构与形象并无因此冲突。",
        "correction": "建议制作母版暂按图6胸前留白，图11继续负责主体造型；若需要标记，另用项目原创标志，作为可换贴花，不重画胸甲。",
        "preserve": "本条是作者建议，用户本次选定图11并未单独否定或批准胸标的最终版本。",
        "status": "recommendation_not_applied"
      },
      {
        "id": "BR11-08",
        "kind": "material_and_state_normalization",
        "group": "制作时归一",
        "title": "腕部能量环和材质按同一位置/状态表达",
        "images": [
          6,
          9,
          10,
          11
        ],
        "observation": "图6/9/11腕环明显，图10合体后不明显；可由外甲遮挡或发光状态解释，不能据此擅自给整机补满亮蓝光条。各图的橙白石墨已属同一家族。",
        "correction": "腕环绑定同一腕部结构；合体后允许外甲遮住，只露局部窄缝，动作时再增强。统一象牙白、主橙、石墨、金属与玻璃的材质来源，保留轰炸机偏石墨、列车偏白、钻机橙白的色块分工。",
        "preserve": "不把所有机组洗成相同橙灰比例；不改已选的英雄色和重拳轮廓。",
        "status": "production_normalization_not_applied"
      }
    ],
